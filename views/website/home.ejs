<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TechComputers - Home</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        body {
            background-color: #f5f7fb;
            font-family: Arial, sans-serif;
        }

        .navbar {
            background: #111827;
        }

        .navbar-brand {
            font-weight: bold;
            color: #00bfff !important;
        }

        .nav-link {
            color: #fff !important;
        }

        .hero {
            background: linear-gradient(135deg, #111827, #2563eb);
            color: white;
            padding: 100px 0;
        }

        .hero h1 {
            font-size: 3.5rem;
            font-weight: 700;
        }

        .hero img {
            max-height: 350px;
            object-fit: contain;
        }

        .section-title {
            font-weight: 700;
            color: #111827;
        }

        .category-card,
        .product-card {
            border: none;
            border-radius: 15px;
            transition: 0.3s;
            background: white;
        }

        .category-card:hover,
        .product-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 10px 25px rgba(0,0,0,.12);
        }

        .category-icon {
            font-size: 45px;
            color: #2563eb;
        }

        .product-card img {
            height: 220px;
            object-fit: contain;
            padding: 20px;
        }

        .price {
            color: #2563eb;
            font-size: 1.4rem;
            font-weight: bold;
        }

        .benefit {
            background: white;
            border-radius: 15px;
            padding: 30px;
            height: 100%;
        }

        footer {
            background: #111827;
            color: white;
        }
    </style>
</head>

<body>

<!-- NAVBAR -->
<nav class="navbar navbar-expand-lg navbar-dark">
    <div class="container">
        <a class="navbar-brand fs-4" href="#">
            <i class="bi bi-pc-display"></i> TechComputers
        </a>

        <button class="navbar-toggler" type="button"
                data-bs-toggle="collapse"
                data-bs-target="#menu">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="menu">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <a class="nav-link" href="#inicio">Inicio</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#categorias">Categorías</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#productos">Computadoras</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#contacto">Contacto</a>
                </li>
            </ul>

            <button class="btn btn-primary ms-lg-3">
                <i class="bi bi-cart3"></i> Comprar
            </button>
        </div>
    </div>
</nav>


<!-- HERO -->
<section class="hero" id="inicio">
    <div class="container">
        <div class="row align-items-center">

            <div class="col-lg-6">
                <span class="badge bg-info text-dark mb-3">
                    Tecnología de última generación
                </span>

                <h1>Encuentra la computadora perfecta para ti</h1>

                <p class="lead mt-3">
                    Laptops, PC Gamer, computadoras de oficina y accesorios
                    con la mejor tecnología y rendimiento.
                </p>

                <div class="mt-4">
                    <a href="#productos" class="btn btn-light btn-lg me-2">
                        Ver computadoras
                    </a>

                    <a href="#categorias" class="btn btn-outline-light btn-lg">
                        Explorar
                    </a>
                </div>
            </div>

            <div class="col-lg-6 text-center mt-5 mt-lg-0">
                <img
                    src="https://images.unsplash.com/photo-1593640408182-31c70c8268f5?auto=format&fit=crop&w=900&q=80"
                    class="img-fluid rounded-4 shadow"
                    alt="Computadora">
            </div>

        </div>
    </div>
</section>


<!-- CATEGORÍAS -->
<section class="py-5" id="categorias">
    <div class="container">

        <div class="text-center mb-5">
            <h2 class="section-title">Explora nuestras categorías</h2>
            <p class="text-muted">
                Tenemos equipos para cada necesidad
            </p>
        </div>

        <div class="row g-4">

            <div class="col-md-6 col-lg-3">
                <div class="category-card text-center p-4 h-100">
                    <i class="bi bi-laptop category-icon"></i>
                    <h4 class="mt-3">Laptops</h4>
                    <p class="text-muted">
                        Equipos portátiles para trabajo y estudio.
                    </p>
                    <button class="btn btn-outline-primary">
                        Ver más
                    </button>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="category-card text-center p-4 h-100">
                    <i class="bi bi-pc-display-horizontal category-icon"></i>
                    <h4 class="mt-3">PC Gamer</h4>
                    <p class="text-muted">
                        Máximo rendimiento para tus videojuegos.
                    </p>
                    <button class="btn btn-outline-primary">
                        Ver más
                    </button>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="category-card text-center p-4 h-100">
                    <i class="bi bi-display category-icon"></i>
                    <h4 class="mt-3">Monitores</h4>
                    <p class="text-muted">
                        Pantallas con gran resolución y calidad.
                    </p>
                    <button class="btn btn-outline-primary">
                        Ver más
                    </button>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="category-card text-center p-4 h-100">
                    <i class="bi bi-keyboard category-icon"></i>
                    <h4 class="mt-3">Accesorios</h4>
                    <p class="text-muted">
                        Teclados, mouse, audífonos y mucho más.
                    </p>
                    <button class="btn btn-outline-primary">
                        Ver más
                    </button>
                </div>
            </div>

        </div>
    </div>
</section>


<!-- PRODUCTOS -->
<section class="py-5 bg-light" id="productos">
    <div class="container">

        <div class="text-center mb-5">
            <h2 class="section-title">Computadoras destacadas</h2>
            <p class="text-muted">
                Descubre nuestros equipos más populares
            </p>
        </div>

        <div class="row g-4">

            <!-- PRODUCTO 1 -->
            <div class="col-md-6 col-lg-4">
                <div class="card product-card h-100 shadow-sm">

                    <img
                        src="https://images.unsplash.com/photo-1603302576837-37561b2e2302?auto=format&fit=crop&w=800&q=80"
                        class="card-img-top"
                        alt="Laptop">

                    <div class="card-body">
                        <span class="badge bg-primary">Laptop</span>

                        <h4 class="card-title mt-2">
                            Laptop Pro 15
                        </h4>

                        <p class="card-text text-muted">
                            Intel Core i7 · 16GB RAM · SSD 512GB
                        </p>

                        <div class="d-flex justify-content-between align-items-center">
                            <span class="price">$899</span>

                            <button class="btn btn-primary">
                                <i class="bi bi-cart-plus"></i>
                                Comprar
                            </button>
                        </div>
                    </div>

                </div>
            </div>


            <!-- PRODUCTO 2 -->
            <div class="col-md-6 col-lg-4">
                <div class="card product-card h-100 shadow-sm">

                    <img
                        src="https://images.unsplash.com/photo-1587831990711-23ca6441447b?auto=format&fit=crop&w=800&q=80"
                        class="card-img-top"
                        alt="PC Gamer">

                    <div class="card-body">
                        <span class="badge bg-danger">Gaming</span>

                        <h4 class="card-title mt-2">
                            PC Gamer Xtreme
                        </h4>

                        <p class="card-text text-muted">
                            Ryzen 7 · 32GB RAM · RTX · SSD 1TB
                        </p>

                        <div class="d-flex justify-content-between align-items-center">
                            <span class="price">$1,499</span>

                            <button class="btn btn-primary">
                                <i class="bi bi-cart-plus"></i>
                                Comprar
                            </button>
                        </div>
                    </div>

                </div>
            </div>


            <!-- PRODUCTO 3 -->
            <div class="col-md-6 col-lg-4">
                <div class="card product-card h-100 shadow-sm">

                    <img
                        src="https://images.unsplash.com/photo-1593640495253-23196b27a87f?auto=format&fit=crop&w=800&q=80"
                        class="card-img-top"
                        alt="Computadora de escritorio">

                    <div class="card-body">
                        <span class="badge bg-success">Oficina</span>

                        <h4 class="card-title mt-2">
                            Desktop Business
                        </h4>

                        <p class="card-text text-muted">
                            Intel Core i5 · 16GB RAM · SSD 512GB
                        </p>

                        <div class="d-flex justify-content-between align-items-center">
                            <span class="price">$699</span>

                            <button class="btn btn-primary">
                                <i class="bi bi-cart-plus"></i>
                                Comprar
                            </button>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
</section>


<!-- BENEFICIOS -->
<section class="py-5">
    <div class="container">

        <div class="text-center mb-5">
            <h2 class="section-title">¿Por qué elegirnos?</h2>
        </div>

        <div class="row g-4">

            <div class="col-md-4">
                <div class="benefit text-center shadow-sm">
                    <i class="bi bi-truck fs-1 text-primary"></i>
                    <h4 class="mt-3">Envíos rápidos</h4>
                    <p class="text-muted">
                        Recibe tus productos de forma rápida y segura.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="benefit text-center shadow-sm">
                    <i class="bi bi-shield-check fs-1 text-success"></i>
                    <h4 class="mt-3">Compra segura</h4>
                    <p class="text-muted">
                        Protegemos tus compras y tus datos personales.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="benefit text-center shadow-sm">
                    <i class="bi bi-headset fs-1 text-info"></i>
                    <h4 class="mt-3">Soporte técnico</h4>
                    <p class="text-muted">
                        Nuestro equipo está listo para ayudarte.
                    </p>
                </div>
            </div>

        </div>
    </div>
</section>


<!-- CTA -->
<section class="py-5 bg-primary text-white">
    <div class="container text-center">
        <h2>¿Listo para mejorar tu computadora?</h2>
        <p class="lead">
            Encuentra el equipo ideal para ti.
        </p>

        <a href="#productos" class="btn btn-light btn-lg">
            Ver catálogo
        </a>
    </div>
</section>


<!-- FOOTER -->
<footer class="py-5" id="contacto">
    <div class="container">

        <div class="row">

            <div class="col-md-6">
                <h4 class="text-info">
                    <i class="bi bi-pc-display"></i>
                    TechComputers
                </h4>

                <p class="text-secondary">
                    Tecnología, rendimiento y calidad para todos.
                </p>
            </div>

            <div class="col-md-3">
                <h5>Enlaces</h5>
                <ul class="list-unstyled">
                    <li><a href="#inicio" class="text-secondary text-decoration-none">Inicio</a></li>
                    <li><a href="#categorias" class="text-secondary text-decoration-none">Categorías</a></li>
                    <li><a href="#productos" class="text-secondary text-decoration-none">Productos</a></li>
                </ul>
            </div>

            <div class="col-md-3">
                <h5>Contacto</h5>
                <p class="text-secondary mb-1">
                    <i class="bi bi-envelope"></i>
                    contacto@techcomputers.com
                </p>

                <p class="text-secondary">
                    <i class="bi bi-telephone"></i>
                    +51 999 999 999
                </p>
            </div>

        </div>

        <hr class="border-secondary">

        <div class="text-center text-secondary">
            © 2026 TechComputers. Todos los derechos reservados.
        </div>

    </div>
</footer>


<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
