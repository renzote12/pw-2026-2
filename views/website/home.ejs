<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Amor & Relax | Habitaciones por horas</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <style>
        body {
            background-color: #120b12;
            color: #fff;
            font-family: Arial, sans-serif;
        }

        .navbar {
            background: #090609;
        }

        .navbar-brand {
            color: #ff4f81 !important;
            font-weight: bold;
            font-size: 1.5rem;
        }

        .nav-link {
            color: #fff !important;
        }

        .hero {
            min-height: 650px;
            display: flex;
            align-items: center;
            background:
                linear-gradient(rgba(20, 5, 15, .65), rgba(20, 5, 15, .85)),
                url("https://images.unsplash.com/photo-1566665797739-1674de7a421a?auto=format&fit=crop&w=1600&q=85")
                center/cover;
        }

        .hero h1 {
            font-size: 4rem;
            font-weight: 800;
        }

        .hero span {
            color: #ff4f81;
        }

        .btn-love {
            background: #e91e63;
            color: #fff;
            border: none;
            padding: 13px 30px;
            border-radius: 30px;
        }

        .btn-love:hover {
            background: #c2185b;
            color: #fff;
        }

        .section-title {
            font-weight: 700;
        }

        .section-title span {
            color: #ff4f81;
        }

        .room-card {
            background: #21141f;
            border: 1px solid #3a2535;
            border-radius: 18px;
            overflow: hidden;
            transition: .3s;
            height: 100%;
        }

        .room-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 35px rgba(233, 30, 99, .25);
        }

        .room-card img {
            height: 240px;
            width: 100%;
            object-fit: cover;
        }

        .room-body {
            padding: 25px;
        }

        .room-title {
            color: #ff6b96;
            font-weight: bold;
        }

        .price {
            color: #fff;
            font-size: 1.4rem;
            font-weight: bold;
        }

        .badge-love {
            background: #e91e63;
        }

        .features {
            background: #1a1019;
        }

        .feature-box {
            background: #251722;
            padding: 30px;
            border-radius: 15px;
            height: 100%;
        }

        .feature-box i {
            color: #ff4f81;
            font-size: 42px;
        }

        .reservation {
            background:
                linear-gradient(rgba(70, 10, 40, .8), rgba(70, 10, 40, .8)),
                url("https://images.unsplash.com/photo-1564078516393-cf04bd966897?auto=format&fit=crop&w=1600&q=80")
                center/cover;
        }

        .form-control,
        .form-select {
            background: #fff;
            border: none;
            padding: 13px;
        }

        footer {
            background: #090609;
        }

        .social i {
            font-size: 22px;
            margin-right: 15px;
            color: #ff4f81;
        }
    </style>
</head>

<body>

<!-- NAVBAR -->
<nav class="navbar navbar-expand-lg navbar-dark sticky-top">
    <div class="container">

        <a class="navbar-brand" href="#">
            <i class="bi bi-heart-fill"></i>
            Amor & Relax
        </a>

        <button class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#menu">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="menu">

            <ul class="navbar-nav ms-auto align-items-lg-center">

                <li class="nav-item">
                    <a class="nav-link" href="#inicio">Inicio</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="#habitaciones">Habitaciones</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="#servicios">Servicios</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="#reservas">Reservas</a>
                </li>

                <li class="nav-item ms-lg-3">
                    <a href="#reservas" class="btn btn-love">
                        Reservar ahora
                    </a>
                </li>

            </ul>

        </div>
    </div>
</nav>


<!-- HERO -->
<section class="hero" id="inicio">

    <div class="container">

        <div class="row">

            <div class="col-lg-7">

                <span class="fs-5">
                    <i class="bi bi-heart-fill"></i>
                    Momentos para recordar
                </span>

                <h1 class="mt-3">
                    Tu privacidad,<br>
                    nuestro compromiso.
                </h1>

                <p class="lead mt-4">
                    Habitaciones privadas por horas, diseñadas para
                    disfrutar momentos especiales en pareja con comodidad,
                    discreción y excelente servicio.
                </p>

                <div class="mt-4">
                    <a href="#habitaciones" class="btn btn-love btn-lg me-2">
                        Ver habitaciones
                    </a>

                    <a href="#reservas"
                       class="btn btn-outline-light btn-lg rounded-pill">
                        Reservar
                    </a>
                </div>

            </div>

        </div>

    </div>
</section>


<!-- HABITACIONES -->
<section class="py-5" id="habitaciones">

    <div class="container">

        <div class="text-center mb-5">

            <h2 class="section-title">
                Nuestras <span>habitaciones</span>
            </h2>

            <p class="text-secondary">
                Elige el ambiente perfecto para tu momento especial.
            </p>

        </div>

        <div class="row g-4">


            <!-- HABITACIÓN 1 -->
            <div class="col-md-6 col-lg-3">

                <div class="room-card">

                    <img
                        src="https://images.unsplash.com/photo-1618773928121-c32242e63f39?auto=format&fit=crop&w=900&q=80"
                        alt="Habitación Clásica">

                    <div class="room-body">

                        <span class="badge badge-love mb-2">
                            Clásica
                        </span>

                        <h4 class="room-title">
                            Habitación Clásica
                        </h4>

                        <p class="text-secondary">
                            Un espacio acogedor y privado para
                            disfrutar de una experiencia tranquila.
                        </p>

                        <ul class="list-unstyled text-secondary">
                            <li>
                                <i class="bi bi-check-circle text-danger"></i>
                                Cama matrimonial
                            </li>
                            <li>
                                <i class="bi bi-check-circle text-danger"></i>
                                TV
                            </li>
                            <li>
                                <i class="bi bi-check-circle text-danger"></i>
                                Baño privado
                            </li>
                        </ul>

                        <div class="d-flex justify-content-between
                                    align-items-center mt-4">

                            <span class="price">
                                S/ 50
                            </span>

                            <a href="#reservas"
                               class="btn btn-love">
                                Reservar
                            </a>

                        </div>

                    </div>

                </div>

            </div>


            <!-- HABITACIÓN 2 -->
            <div class="col-md-6 col-lg-3">

                <div class="room-card">

                    <img
                        src="https://images.unsplash.com/photo-1590490360182-c33d57733427?auto=format&fit=crop&w=900&q=80"
                        alt="Habitación Premium">

                    <div class="room-body">

                        <span class="badge badge-love mb-2">
                            Premium
                        </span>

                        <h4 class="room-title">
                            Habitación Premium
                        </h4>

                        <p class="text-secondary">
                            Ambiente elegante con detalles pensados
                            para una velada especial.
                        </p>

                        <ul class="list-unstyled text-secondary">
                            <li>
                                <i class="bi bi-check-circle text-danger"></i>
                                Cama King
                            </li>
                            <li>
                                <i class="bi bi-check-circle text-danger"></i>
                                Smart TV
                            </li>
                            <li>
                                <i class="bi bi-check-circle text-danger"></i>
                                Aire acondicionado
                            </li>
                        </ul>

                        <div class="d-flex justify-content-between
                                    align-items-center mt-4">

                            <span class="price">
                                S/ 80
                            </span>

                            <a href="#reservas"
                               class="btn btn-love">
                                Reservar
                            </a>

                        </div>

                    </div>

                </div>

            </div>


            <!-- HABITACIÓN 3 -->
            <div class="col-md-6 col-lg-3">

                <div class="room-card">

                    <img
                        src="https://images.unsplash.com/photo-1551882547-ff40c63fe5fa?auto=format&fit=crop&w=900&q=80"
                        alt="Habitación Jacuzzi">

                    <div class="room-body">

                        <span class="badge badge-love mb-2">
                            Relax
                        </span>

                        <h4 class="room-title">
                            Suite Jacuzzi
                        </h4>

                        <p class="text-secondary">
                            Una experiencia de relajación con
                            jacuzzi privado y ambiente romántico.
                        </p>

                        <ul class="list-unstyled text-secondary">
                            <li>
                                <i class="bi bi-check-circle text-danger"></i>
                                Cama King
                            </li>
                            <li>
                                <i class="bi bi-check-circle text-danger"></i>
                                Jacuzzi privado
                            </li>
                            <li>
                                <i class="bi bi-check-circle text-danger"></i>
                                Iluminación ambiental
                            </li>
                        </ul>

                        <div class="d-flex justify-content-between
                                    align-items-center mt-4">

                            <span class="price">
                                S/ 120
                            </span>

                            <a href="#reservas"
                               class="btn btn-love">
                                Reservar
                            </a>

                        </div>

                    </div>

                </div>

            </div>


            <!-- HABITACIÓN 4 -->
            <div class="col-md-6 col-lg-3">

                <div class="room-card">

                    <img
                        src="https://images.unsplash.com/photo-1601918774946-25832a4be0d6?auto=format&fit=crop&w=900&q=80"
                        alt="Suite VIP">

                    <div class="room-body">

                        <span class="badge badge-love mb-2">
                            VIP
                        </span>

                        <h4 class="room-title">
                            Suite VIP
                        </h4>

                        <p class="text-secondary">
                            Nuestra habitación exclusiva para
                            quienes buscan una experiencia premium.
                        </p>

                        <ul class="list-unstyled text-secondary">
                            <li>
                                <i class="bi bi-check-circle text-danger"></i>
                                Cama King
                            </li>
                            <li>
                                <i class="bi bi-check-circle text-danger"></i>
                                Jacuzzi
                            </li>
                            <li>
                                <i class="bi bi-check-circle text-danger"></i>
                                Bar privado
                            </li>
                        </ul>

                        <div class="d-flex justify-content-between
                                    align-items-center mt-4">

                            <span class="price">
                                S/ 180
                            </span>

                            <a href="#reservas"
                               class="btn btn-love">
                                Reservar
                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- SERVICIOS -->
<section class="features py-5" id="servicios">

    <div class="container">

        <div class="text-center mb-5">

            <h2 class="section-title">
                Todo pensado para <span>ustedes</span>
            </h2>

        </div>

        <div class="row g-4">

            <div class="col-md-4">

                <div class="feature-box text-center">

                    <i class="bi bi-shield-lock"></i>

                    <h4 class="mt-3">
                        Privacidad
                    </h4>

                    <p class="text-secondary">
                        Espacios privados y atención discreta
                        para que disfrutes sin preocupaciones.
                    </p>

                </div>

            </div>


            <div class="col-md-4">

                <div class="feature-box text-center">

                    <i class="bi bi-clock-history"></i>

                    <h4 class="mt-3">
                        Por horas
                    </h4>

                    <p class="text-secondary">
                        Elige la duración de tu estadía según
                        tus necesidades.
                    </p>

                </div>

            </div>


            <div class="col-md-4">

                <div class="feature-box text-center">

                    <i class="bi bi-stars"></i>

                    <h4 class="mt-3">
                        Experiencia premium
                    </h4>

                    <p class="text-secondary">
                        Habitaciones cuidadosamente preparadas
                        para una experiencia especial.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- RESERVA -->
<section class="reservation py-5" id="reservas">

    <div class="container">

        <div class="row justify-content-center">

            <div class="col-lg-8">

                <div class="text-center mb-4">

                    <h2 class="fw-bold">
                        Reserva tu habitación
                    </h2>

                    <p>
                        Selecciona tu habitación y horario.
                    </p>

                </div>

                <div class="card bg-dark border-0 shadow-lg p-4">

                    <form>

                        <div class="row g-3">

                            <div class="col-md-6">

                                <label class="form-label">
                                    Nombre
                                </label>

                                <input type="text"
                                       class="form-control"
                                       placeholder="Tu nombre"
                                       required>

                            </div>


                            <div class="col-md-6">

                                <label class="form-label">
                                    Teléfono
                                </label>

                                <input type="tel"
                                       class="form-control"
                                       placeholder="999 999 999"
                                       required>

                            </div>


                            <div class="col-md-6">

                                <label class="form-label">
                                    Habitación
                                </label>

                                <select class="form-select">

                                    <option>
                                        Habitación Clásica
                                    </option>

                                    <option>
                                        Habitación Premium
                                    </option>

                                    <option>
                                        Suite Jacuzzi
                                    </option>

                                    <option>
                                        Suite VIP
                                    </option>

                                </select>

                            </div>


                            <div class="col-md-6">

                                <label class="form-label">
                                    Duración
                                </label>

                                <select class="form-select">

                                    <option>
                                        3 horas
                                    </option>

                                    <option>
                                        6 horas
                                    </option>

                                    <option>
                                        12 horas
                                    </option>

                                    <option>
                                        24 horas
                                    </option>

                                </select>

                            </div>


                            <div class="col-md-6">

                                <label class="form-label">
                                    Fecha
                                </label>

                                <input type="date"
                                       class="form-control"
                                       required>

                            </div>


                            <div class="col-md-6">

                                <label class="form-label">
                                    Hora de llegada
                                </label>

                                <input type="time"
                                       class="form-control"
                                       required>

                            </div>


                            <div class="col-12">

                                <button type="submit"
                                        class="btn btn-love w-100 btn-lg">

                                    <i class="bi bi-heart-fill"></i>
                                    Solicitar reserva

                                </button>

                            </div>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- FOOTER -->
<footer class="py-5">

    <div class="container">

        <div class="row">

            <div class="col-md-6">

                <h4 class="text-danger">
                    <i class="bi bi-heart-fill"></i>
                    Amor & Relax
                </h4>

                <p class="text-secondary">
                    Momentos especiales merecen un lugar especial.
                </p>

                <div class="social">
                    <i class="bi bi-facebook"></i>
                    <i class="bi bi-instagram"></i>
                    <i class="bi bi-whatsapp"></i>
                </div>

            </div>


            <div class="col-md-3">

                <h5>Información</h5>

                <ul class="list-unstyled text-secondary">

                    <li class="mb-2">
                        Habitaciones por horas
                    </li>

                    <li class="mb-2">
                        Atención todos los días
                    </li>

                    <li class="mb-2">
                        Atención privada
                    </li>

                </ul>

            </div>


            <div class="col-md-3">

                <h5>Contacto</h5>

                <p class="text-secondary mb-2">
                    <i class="bi bi-telephone"></i>
                    +51 999 999 999
                </p>

                <p class="text-secondary">
                    <i class="bi bi-geo-alt"></i>
                    Lima, Perú
                </p>

            </div>

        </div>

        <hr class="border-secondary">

        <p class="text-center text-secondary mb-0">
            © 2026 Amor & Relax — Todos los derechos reservados.
        </p>

    </div>

</footer>


<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
